VPS_URL=wss://crm.example.com/agent
AGENT_ID=room-lab-01
AGENT_TOKEN=paste-one-time-agent-token
ROOM_ID=00000000-0000-0000-0000-000000000001
LOCAL_ORIGINS=http://127.0.0.1:3000,http://192.168.1.20:8080
ALLOWED_COMMANDS=status,start_game,pause_game,reset_room,send_hint
COMMAND_API=http://127.0.0.1:3000/api
# GET endpoint on the first LOCAL_ORIGINS host. It describes blocks, categories and controls.
ROOM_CONFIG_PATH=/api/room-config
HEARTBEAT_MS=15000
REQUEST_TIMEOUT_MS=5000
AUDIO_PLAYER=ffplay
# Optional ALSA/PulseAudio output understood by the selected player:
# AUDIO_DEVICE=
# LOCAL_ORIGINS must include the origin hosting the Krampus API.
# Krampus endpoints used by the agent:
# GET /api/status, /api/sensors, /api/serial/tail
# POST /api/serial/config with {"path":"/dev/ttyUSB0"}
# POST /api/admin, /api/sound/play, /api/sound/stop
