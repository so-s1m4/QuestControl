[Unit]
Description=QuestControl Room Agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=quest-agent
SupplementaryGroups=audio
WorkingDirectory=/opt/quest-control-room-agent/current
EnvironmentFile=/etc/quest-control/room-agent.env
ExecStart=/usr/bin/node /opt/quest-control-room-agent/current/src/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quest-control-agent
[Install]
WantedBy=multi-user.target
