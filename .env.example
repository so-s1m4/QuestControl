NODE_ENV=production
POSTGRES_DB=quest_control
POSTGRES_USER=quest
POSTGRES_PASSWORD=replace-with-32-random-characters
DATABASE_URL=postgresql://quest:replace-with-32-random-characters@postgres:5432/quest_control
REDIS_PASSWORD=replace-with-another-long-random-secret
REDIS_URL=redis://:replace-with-another-long-random-secret@redis:6379
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-character-secret
PSEUDONYMIZATION_SECRET=replace-with-a-separate-64-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PUBLIC_URL=https://crm.example.com
CORS_ORIGIN=https://crm.example.com
TRUST_PROXY=1
# Internal service used to execute document scripts and fill DOCX templates.
DOCUMENT_RUNNER_URL=http://document-runner:8080
# Shared secret for internal communication between API and local AI service
INTERNAL_API_SECRET=replace-with-at-least-32-random-characters
TUYA_AI_HLS_FALLBACK=true
# Tuya stream type 2 is the main stream used by the server-side AI worker.
TUYA_AI_STREAM_TYPE=2
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_MESSAGE_URL=wss://mqe.tuyaeu.com:8285/
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TIME_TO_GROW_BASE_URL=https://api.time-to-grow.com
TIME_TO_GROW_CLUB_ID=
TIME_TO_GROW_VIENNA_CLUB_ID=01js42s5vwvwrx3fme9zvgdj1v
TIME_TO_GROW_JWT=
TIME_TO_GROW_EMAIL=
TIME_TO_GROW_PASSWORD=
VR_SANKT_POELTEN_PANEL_URL=http://172.23.0.1:30000
VR_SANKT_POELTEN_DEVICE_URL=http://172.23.0.1:6101
GO2RTC_BASE_URL=http://127.0.0.1:1984
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-on-first-login
# Create a bot with @BotFather. Never commit the actual token.
TELEGRAM_BOT_TOKEN=
# Public username without @, used to open the account-linking flow from the panel.
TELEGRAM_BOT_USERNAME=
